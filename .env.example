# Copy to .env. Values are loaded from the environment only.
# Never commit a real .env, and never paste these into agent prompts.

OPENAI_API_KEY=
MASSIVE_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false

# Massive (formerly Polygon.io). Free tier is the default.
MASSIVE_BASE_URL=https://api.massive.com
MASSIVE_PLAN=free
MASSIVE_RATE_LIMIT_PER_MINUTE=5
MASSIVE_MAX_LOOKBACK_DAYS=730
MASSIVE_CHUNK_CALENDAR_DAYS=70
MASSIVE_PAGE_LIMIT=50000
MASSIVE_MAX_RETRIES=5

# Local cache, universe, and the protected research holdout.
DATA_CACHE_DIR=data/cache
UNIVERSE_PATH=config/universe.yaml
HOLDOUT_START=2026-07-01
HOLDOUT_END=2026-10-31

# Phase 3 research agents. Keys stay in this file; they are not sent to the model.
# Default model is GPT-6.1 Sol. Point AEGIS_RESEARCH_MODEL at another current
# model (for example gpt-6-astra) if you want a different tradeoff.
# Per-role overrides fall back to AEGIS_RESEARCH_MODEL when empty.
AEGIS_RESEARCH_MODEL=gpt-6.1-sol
AEGIS_ORCHESTRATOR_MODEL=
AEGIS_RESEARCHER_MODEL=
AEGIS_IMPLEMENTER_MODEL=
AEGIS_NAYSAYER_MODEL=
AEGIS_MAX_INPUT_TOKENS=150000
AEGIS_MAX_OUTPUT_TOKENS=40000
AEGIS_MAX_COST_USD=3
AEGIS_MAX_LLM_CALLS=24
AEGIS_PRICE_INPUT_PER_MTOK=2
AEGIS_PRICE_OUTPUT_PER_MTOK=10
AEGIS_AUDIT_DIR=data/audit
AEGIS_RESEARCH_DIR=data/research
AEGIS_PROMPT_VERSION=v1
AEGIS_SANDBOX_TIMEOUT_SECONDS=15
AEGIS_SANDBOX_MEMORY_MB=2048

# Human kill switch. Risk limits themselves are not env-tunable.
# `aegis paper kill` also writes data/paper/KILL. Delete that file by hand
# after the account is flat; this build has no unkill command.
RISK_KILL_SWITCH=false
PAPER_DIR=data/paper
PAPER_RECONCILE_SECONDS=30
PAPER_POLL_SECONDS=15
STARTING_EQUITY=100000
COMMISSION_PER_SHARE=0.005
SLIPPAGE_BPS=5
